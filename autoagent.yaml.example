# AutoAgent Configuration
# This file defines tasks for automated execution using Claude AI or shell commands

version: "1.0"

# Global default settings (can be overridden per task)
defaults:
  model: sonnet  # Options: sonnet, opus, haiku (for prompt tasks)
  agent: claude  # Options: claude, codex (agent type to use for prompt tasks)
  branch_strategy: separate  # Options: separate (create new branches), main (work on main)
  auto_push: false  # Whether to push to remote after successful task completion
  abort_on_failure: true  # Abort all remaining tasks if one fails

# Task definitions
# Two types of tasks are supported:
# 1. "prompt" tasks - Send prompts to AI (default type)
# 2. "command" tasks - Execute shell commands
#
# Execution order is controlled by the execution_step field:
# - Tasks with the same execution_step run in parallel
# - Lower steps run before higher steps (step 1 completes before step 2 starts)
# - Default execution_step is 1 if not specified

tasks:
  # Example 1: Two tasks running in parallel (both step 1)
  - name: Lint code
    type: command
    command: ruff check .
    execution_step: 1  # Runs in parallel with Format code

  - name: Format code
    type: command
    command: black --check .
    execution_step: 1  # Runs in parallel with Lint code

  # Example 2: Task that waits for step 1 to complete
  - name: Run tests
    type: command
    command: pytest tests/ -v
    execution_step: 2  # Runs after step 1 completes
    timeout: 600

  # Example 3: Multiple tasks in step 2 (running in parallel after step 1)
  - name: Check types
    type: command
    command: mypy .
    execution_step: 2  # Runs in parallel with Run tests

  # Example 4: AI analysis after all checks pass
  - name: AI code review
    type: prompt
    prompt: |
      Review the recent code changes and suggest any improvements
      for code quality, performance, or maintainability.
    execution_step: 3  # Runs after steps 1 and 2 complete
    model: opus

  # Example 5: Build after review
  - name: Build project
    type: command
    command: python -m build
    execution_step: 4
    timeout: 300

  # Example 6: Final summary
  - name: Generate summary
    type: prompt
    prompt: |
      Summarize all the checks, tests, and build results.
      Highlight any issues that need attention.
    execution_step: 5
    model: sonnet
    auto_push: true  # Push after completion
