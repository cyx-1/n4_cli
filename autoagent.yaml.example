# AutoAgent Configuration
# This file defines tasks for automated execution using Claude AI or shell commands

version: "1.0"

# Global default settings (can be overridden per task)
defaults:
  model: sonnet  # Options: sonnet, opus, haiku (for prompt tasks)
  agent: claude  # Options: claude, codex (agent type to use for prompt tasks)
  branch_strategy: separate  # Options: separate (create new branches), main (work on main)
  auto_push: false  # Whether to push to remote after successful task completion
  abort_on_failure: true  # Abort all remaining tasks if one fails

# Task definitions
# Four types of tasks are supported:
# 1. "prompt" tasks - Send prompts to AI (default type)
# 2. "command" tasks - Execute shell commands
# 3. "goto" tasks - Jump to a specific execution step (for loops/conditionals)
# 4. "prepare_next_prompt" tasks - Process a plan file to manage multi-step prompts
#
# Execution order is controlled by the execution_step field:
# - Tasks with the same execution_step run in parallel
# - Lower steps run before higher steps (step 1 completes before step 2 starts)
# - Default execution_step is 1 if not specified

tasks:
  # Example 1: Two tasks running in parallel (both step 1)
  - name: Lint code
    type: command
    command: ruff check .
    execution_step: 1  # Runs in parallel with Format code

  - name: Format code
    type: command
    command: black --check .
    execution_step: 1  # Runs in parallel with Lint code

  # Example 2: Task that waits for step 1 to complete
  - name: Run tests
    type: command
    command: pytest tests/ -v
    execution_step: 2  # Runs after step 1 completes
    timeout: 600

  # Example 3: Multiple tasks in step 2 (running in parallel after step 1)
  - name: Check types
    type: command
    command: mypy .
    execution_step: 2  # Runs in parallel with Run tests

  # Example 4: AI analysis after all checks pass
  - name: AI code review
    type: prompt
    prompt: |
      Review the recent code changes and suggest any improvements
      for code quality, performance, or maintainability.
    execution_step: 3  # Runs after steps 1 and 2 complete
    model: opus

  # Example 5: Build after review
  - name: Build project
    type: command
    command: python -m build
    execution_step: 4
    timeout: 300

  # Example 6: Final summary
  - name: Generate summary
    type: prompt
    prompt: |
      Summarize all the checks, tests, and build results.
      Highlight any issues that need attention.
    execution_step: 5
    model: sonnet
    auto_push: true  # Push after completion

# ============================================================================
# ADVANCED EXAMPLES: Looping with prepare_next_prompt and goto
# ============================================================================
# The following example demonstrates how to create a loop that processes
# multiple prompts from a plan file. This is useful for:
# - Multi-step implementations where each step should be committed
# - Iterative refactoring tasks
# - Processing a list of related tasks sequentially
#
# Plan file format (plan.yaml):
# ```yaml
# prompts:
#   - prompt: "Implement user authentication"
#     status: incomplete
#   - prompt: "Add password reset functionality"
#     status: incomplete
#   - prompt: "Create user profile page"
#     status: incomplete
# ```
#
# The prepare_next_prompt task:
# 1. Marks the first incomplete prompt as complete
# 2. Saves the plan file with updated status
# 3. Writes the next incomplete prompt to the prompt_file
# 4. Returns 'no_more_prompts' error_type when all prompts are done
#
# Example workflow that loops through all prompts in a plan file:
#
#   - name: Prepare next task
#     type: prepare_next_prompt
#     plan_file: plan.yaml        # YAML file with prompts and their status
#     prompt_file: current.txt    # File where the next prompt will be written
#     execution_step: 10
#
#   - name: Execute current task
#     type: prompt
#     prompt_file: current.txt    # Load the prompt from the file
#     execution_step: 11
#     model: opus
#
#   - name: Loop back
#     type: goto
#     goto_step: 10               # Jump back to step 10 to process next prompt
#     execution_step: 12
#
# Note: The loop continues until prepare_next_prompt returns 'no_more_prompts',
# which indicates all prompts in the plan file have been completed.
